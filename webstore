<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>البورصة - World Class UI</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #0A0A0C;
            --bg-card: rgba(26, 26, 30, 0.6);
            --primary: #00E5FF; /* Cyan */
            --primary-glow: rgba(0, 229, 255, 0.2);
            --accent: #A855F7; /* Purple */
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
            --border: rgba(255, 255, 255, 0.08);
            --glass: rgba(10, 10, 12, 0.85);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; -webkit-tap-highlight-color: transparent; }

        body {
            background-color: #000; display: flex; justify-content: center; align-items: center;
            min-height: 100vh; color: var(--text-main); overflow: hidden;
            /* Background Mesh Gradient for Modern Feel */
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 229, 255, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(168, 85, 247, 0.1) 0px, transparent 50%);
        }

        .app-container {
            width: 100%; max-width: 400px; height: 100vh; max-height: 850px;
            background-color: var(--bg-main); position: relative;
            overflow: hidden; box-shadow: 0 0 80px rgba(0, 0, 0, 0.8);
            border: 1px solid var(--border); border-radius: 20px;
        }

        .screen { 
            display: none; flex-direction: column; position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            overflow-y: auto; padding-bottom: 110px;
        }
        .screen::-webkit-scrollbar { display: none; }
        .screen.active { display: flex; animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Glassmorphism Header */
        .header {
            padding: 20px; display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; background: var(--glass);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            z-index: 100; border-bottom: 1px solid var(--border);
        }

        .user-info h2 { font-size: 13px; color: var(--text-muted); font-weight: 600; }
        .user-info h1 { font-size: 26px; font-weight: 900; color: #FFF; letter-spacing: -0.5px; }

        .header-actions { display: flex; gap: 12px; }
        .icon-btn {
            width: 45px; height: 45px; background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 16px; display: flex; justify-content: center; align-items: center;
            font-size: 20px; cursor: pointer; position: relative; backdrop-filter: blur(10px);
        }
        .badge {
            position: absolute; top: -5px; right: -5px; background: var(--accent); color: white;
            font-size: 11px; font-weight: 900; width: 22px; height: 22px; border-radius: 50%;
            display: flex; justify-content: center; align-items: center; border: 2px solid var(--bg-main);
        }

        /* Exaggerated Minimal Search */
        .search-container { padding: 15px 20px 20px 20px; }
        .search-box {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 20px;
            padding: 16px 20px; display: flex; align-items: center; gap: 12px; transition: 0.3s;
            backdrop-filter: blur(10px);
        }
        .search-box:focus-within { border-color: var(--primary); box-shadow: 0 0 20px var(--primary-glow); }
        .search-box span { color: var(--primary); font-size: 20px; }
        .search-box input { background: transparent; border: none; outline: none; color: white; font-size: 16px; font-weight: 600; width: 100%; }

        /* Exaggerated Titles */
        .section-title { padding: 10px 20px 20px 20px; font-size: 26px; font-weight: 900; letter-spacing: -1px;}
        .back-btn { background: var(--bg-card); border: 1px solid var(--border); color: var(--text-main); padding: 8px 20px; border-radius: 12px; cursor: pointer; font-size: 15px; font-weight: 700; backdrop-filter: blur(10px);}

        /* Categories with Modern Glass */
        .categories-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 0 20px; }
        .category-card {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 24px;
            height: 150px; display: flex; flex-direction: column; justify-content: center; align-items: center;
            gap: 12px; position: relative; overflow: hidden; cursor: pointer; transition: 0.3s;
            backdrop-filter: blur(10px);
        }
        .category-card:active { transform: scale(0.96); border-color: var(--primary); }
        .category-icon { font-size: 50px; z-index: 1; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); }
        .category-name { font-size: 17px; font-weight: 800; z-index: 1; color: #FFF; text-align: center; }
        .category-count { font-size: 13px; color: var(--primary); font-weight: 700; z-index: 1; }

        /* Products */
        .products-list { padding: 0 20px; display: flex; flex-direction: column; gap: 16px; }
        .product-card {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 24px;
            padding: 20px; display: flex; flex-direction: column; position: relative;
            backdrop-filter: blur(10px); transition: 0.3s;
        }
        .product-card:active { border-color: var(--accent); }
        
        .product-header { display: flex; gap: 15px; align-items: center; margin-bottom: 20px;}
        .product-img { width: 80px; height: 80px; background: rgba(255,255,255,0.05); border-radius: 18px; display: flex; justify-content: center; align-items: center; font-size: 45px; flex-shrink: 0;}
        .product-info { flex: 1;}
        .product-name { font-size: 22px; font-weight: 900; margin-bottom: 4px; letter-spacing: -0.5px;}
        .product-desc { font-size: 14px; color: var(--text-muted); font-weight: 600;}

        /* Glass Pickers */
        .picker-group { display: flex; gap: 10px; margin-bottom: 20px;}
        .picker-box {
            flex: 1; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 14px;
            padding: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.2s; backdrop-filter: blur(5px);
        }
        .picker-box:active { background: rgba(255,255,255,0.1); border-color: var(--primary); }
        .picker-label { font-size: 11px; color: var(--text-muted); margin-bottom: 4px; font-weight: 700;}
        .picker-value { font-weight: 900; color: var(--primary); font-size: 15px;}

        /* Action & Price (Exaggerated) */
        .action-row { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 15px;}
        .price-box { display: flex; align-items: baseline; gap: 5px;}
        .price { font-size: 28px; font-weight: 900; color: var(--text-main); letter-spacing: -1px;}
        .price span { font-size: 14px; color: var(--primary); font-weight: 700;}
        
        .controls { display: flex; gap: 15px; align-items: center;}
        .qty-controls { display: flex; align-items: center; gap: 15px; background: rgba(255,255,255,0.05); border-radius: 12px; padding: 8px 12px;}
        .qty-btn { background: transparent; border: none; color: var(--text-main); font-size: 22px; font-weight: bold; cursor: pointer;}
        .qty-num { font-size: 18px; font-weight: 900; width: 20px; text-align: center;}

        .add-btn-main {
            background: var(--primary); color: #000; border: none;
            padding: 12px 24px; border-radius: 12px; font-weight: 900; font-size: 16px; cursor: pointer; transition: 0.2s;
            box-shadow: 0 5px 15px var(--primary-glow);
        }
        .add-btn-main:active { transform: scale(0.95); box-shadow: none; }

        /* Cart */
        .cart-items { padding: 0 20px; display: flex; flex-direction: column; gap: 12px; }
        .cart-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 20px; padding: 20px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(10px);}
        .cart-item-info { display: flex; align-items: center; gap: 15px;}
        .cart-item-name { font-size: 18px; font-weight: 800; }
        .cart-item-qty { font-size: 13px; color: var(--text-muted); font-weight: 600;}
        .cart-item-price { font-size: 20px; font-weight: 900; color: var(--primary); }
        
        .cart-total { padding: 20px; font-size: 22px; font-weight: 800; text-align: left; margin-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;}
        .cart-total span { color: var(--primary); font-size: 32px; font-weight: 900; letter-spacing: -1px;}
        
        .checkout-btn { background: var(--primary); color: black; padding: 20px; text-align: center; border-radius: 20px; font-weight: 900; font-size: 20px; margin: 0 20px; cursor: pointer; box-shadow: 0 10px 25px var(--primary-glow); }

        /* Bottom Nav (Floating Pill) */
        .bottom-nav {
            position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
            width: 90%; max-width: 340px;
            background: var(--glass);
            backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
            border: 1px solid var(--border); border-radius: 30px;
            display: flex; justify-content: space-around; padding: 10px;
            z-index: 1000; box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }
        .nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; color: var(--text-muted); cursor: pointer; padding: 10px 20px; border-radius: 20px; transition: 0.3s; }
        .nav-item.active { color: var(--primary); background: rgba(0, 229, 255, 0.1); }
        .nav-item span { font-size: 24px; }
        .nav-item p { font-size: 12px; font-weight: 800; }

        /* Bottom Sheet Modal (Glassmorphism) */
        .bottom-sheet-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); z-index: 2000; opacity: 0; pointer-events: none; transition: 0.3s;
            backdrop-filter: blur(5px);
        }
        .bottom-sheet-overlay.active { opacity: 1; pointer-events: auto; }

        .bottom-sheet {
            position: absolute; bottom: -100%; left: 0; width: 100%;
            background: rgba(20, 20, 25, 0.95); border-radius: 30px 30px 0 0;
            padding: 25px; z-index: 2001; transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.1);
            box-shadow: 0 -20px 50px rgba(0,0,0,0.8); border-top: 1px solid var(--border);
            backdrop-filter: blur(20px);
        }
        .bottom-sheet.active { bottom: 0; }
        
        .sheet-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .sheet-header h3 { font-size: 22px; font-weight: 900; }
        .close-btn { background: rgba(255,255,255,0.1); border: none; color: white; width: 35px; height: 35px; border-radius: 50%; cursor: pointer; display: flex; justify-content: center; align-items: center; font-size: 16px;}

        .sheet-option {
            padding: 18px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;
            font-size: 18px; font-weight: 700; cursor: pointer; transition: 0.2s;
        }
        .sheet-option:active { background: rgba(255,255,255,0.05); }
        .sheet-option.selected { color: var(--primary); }

    </style>
</head>
<body>

    <div class="app-container">
        
        <!-- HOME SCREEN -->
        <div id="screen-home" class="screen active">
            <header class="header">
                <div class="user-info"><h2>أهلاً بك،</h2><h1>كانها</h1></div>
                <div class="header-actions">
                    <div class="icon-btn" onclick="switchScreen('cart')">
                        🛒<div class="badge" id="cart-badge">0</div>
                    </div>
                </div>
            </header>

            <div class="search-container">
                <div class="search-box"><span>🔍</span><input type="text" placeholder="ابحث عن ما تحتاجه..."></div>
            </div>

            <div class="section-title">تسوق الآن</div>
            
            <div class="categories-grid">
                <div class="category-card" onclick="openCategory('خضر وفواكه')">
                    <div class="category-icon">🥦</div><div class="category-name">الخضر والفواكه</div><div class="category-count">3 أصناف</div>
                </div>
                <div class="category-card" onclick="openCategory('أواني منزلية')">
                    <div class="category-icon">🍽️</div><div class="category-name">أواني منزلية</div><div class="category-count">3 أصناف</div>
                </div>
                <div class="category-card" onclick="openCategory('لحوم ودواجن')">
                    <div class="category-icon">🥩</div><div class="category-name">لحوم ودواجن</div><div class="category-count">3 أصناف</div>
                </div>
                <div class="category-card" onclick="openCategory('حليب ومشتقاته')">
                    <div class="category-icon">🥛</div><div class="category-name">حليب ومشتقاته</div><div class="category-count">3 أصناف</div>
                </div>
            </div>
        </div>

        <!-- PRODUCTS SCREEN -->
        <div id="screen-products" class="screen">
            <header class="header">
                <div class="user-info"><h2>القسم</h2><h1 id="current-cat-name">الاسم</h1></div>
                <div class="header-actions">
                    <div class="icon-btn" onclick="switchScreen('cart')">
                        🛒<div class="badge" id="cart-badge-2">0</div>
                    </div>
                </div>
            </header>
            <div class="section-title">
                <button class="back-btn" onclick="switchScreen('home')">→ رجوع</button>
            </div>

            <div class="products-list" id="products-container"></div>
        </div>

        <!-- CART SCREEN -->
        <div id="screen-cart" class="screen">
            <header class="header">
                <div class="user-info"><h2>السلة</h2><h1>مشترياتك</h1></div>
            </header>
            
            <div class="cart-items" id="cart-list">
                <p style="color:var(--text-muted); text-align:center; margin-top:20px; font-size:18px;">السلة فاضية حالياً</p>
            </div>

            <div class="cart-total">الإجمالي: <span id="cart-total-price">0</span></div>
            
            <div style="margin-top:20px; margin-bottom: 50px;">
                <div class="checkout-btn" onclick="alert('تم تأكيد الطلب بنجاح!')">تأكيد الطلب</div>
            </div>
        </div>

        <!-- BOTTOM NAVIGATION -->
        <nav class="bottom-nav">
            <div class="nav-item active" id="nav-home" onclick="switchScreen('home')"><span>🏠</span><p>الرئيسية</p></div>
            <div class="nav-item" id="nav-cart" onclick="switchScreen('cart')"><span>🛒</span><p>السلة</p></div>
        </nav>

        <!-- BOTTOM SHEET (Glass) -->
        <div class="bottom-sheet-overlay" id="sheet-overlay" onclick="closeSheet()"></div>
        <div class="bottom-sheet" id="bottom-sheet">
            <div class="sheet-header">
                <h3 id="sheet-title">اختر</h3>
                <button class="close-btn" onclick="closeSheet()">✕</button>
            </div>
            <div id="sheet-options"></div>
        </div>

    </div>

    <script>
        const db = {
            'خضر وفواكه': [
                { id: 'p1', name: 'تفاح أحمر', desc: 'فواكه طازجة', icon: '🍎', price: 250 },
                { id: 'p2', name: 'موز', desc: 'فواكه', icon: '🍌', price: 180 },
                { id: 'p3', name: 'بطاطا', desc: 'خضر', icon: '🥔', price: 95 }
            ],
            'أواني منزلية': [
                { id: 'p4', name: 'كوب ماء', desc: 'أواني', icon: '🥛', price: 350 },
                { id: 'p5', name: 'طقم صحون', desc: 'أواني', icon: '🍽️', price: 1200 }
            ],
            'لحوم ودواجن': [
                { id: 'p7', name: 'دجاج طازج', desc: 'لحوم', icon: '🍗', price: 450 },
                { id: 'p8', name: 'لحم بقري', desc: 'لحوم', icon: '🥩', price: 1800 }
            ],
            'حليب ومشتقاته': [
                { id: 'p10', name: 'حليب', desc: 'حليب', icon: '🥛', price: 125 }
            ]
        };

        let cart = [];
        let total = 0;
        let quantities = {}; 
        let activePickerElement = null; 

        function switchScreen(screenName) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('screen-' + screenName).classList.add('active');
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            if(screenName === 'home') document.getElementById('nav-home').classList.add('active');
            if(screenName === 'cart') document.getElementById('nav-cart').classList.add('active');
        }

        function openCategory(catName) {
            document.getElementById('current-cat-name').innerText = catName;
            const products = db[catName] || [];
            const container = document.getElementById('products-container');
            container.innerHTML = '';

            products.forEach(product => {
                if (!quantities[product.id]) quantities[product.id] = 1;

                container.innerHTML += `
                    <div class="product-card">
                        <div class="product-header">
                            <div class="product-img">${product.icon}</div>
                            <div class="product-info">
                                <div class="product-name">${product.name}</div>
                                <div class="product-desc">${product.desc}</div>
                            </div>
                        </div>
                        
                        <div class="picker-group">
                            <div class="picker-box" onclick="openSheet('الماركة', ['عام', 'سكور', 'كانديا'], this)">
                                <div class="picker-label">الماركة</div>
                                <div class="picker-value">عام ▼</div>
                            </div>
                            <div class="picker-box" onclick="openSheet('الحجم', ['1 كغ', '2 كغ', '5 كغ'], this)">
                                <div class="picker-label">الحجم</div>
                                <div class="picker-value">1 كغ ▼</div>
                            </div>
                        </div>

                        <div class="action-row">
                            <div class="price-box">
                                <div class="price">${product.price} <span>د.ج</span></div>
                            </div>
                            <div class="controls">
                                <div class="qty-controls">
                                    <button class="qty-btn" onclick="changeQty('${product.id}', -1)">-</button>
                                    <span class="qty-num" id="qty-${product.id}">1</span>
                                    <button class="qty-btn" onclick="changeQty('${product.id}', 1)">+</button>
                                </div>
                                <button class="add-btn-main" onclick="addToCart('${product.name}', ${product.price}, '${product.id}')">إضافة</button>
                            </div>
                        </div>
                    </div>
                `;
            });

            switchScreen('products');
        }

        function changeQty(productId, change) {
            let currentQty = quantities[productId];
            let newQty = currentQty + change;
            if (newQty >= 1) {
                quantities[productId] = newQty;
                document.getElementById('qty-' + productId).innerText = newQty;
            }
        }

        function addToCart(itemName, itemPrice, productId) {
            let qty = quantities[productId];
            cart.push({ name: itemName, price: itemPrice, qty: qty });
            total += (itemPrice * qty);
            updateCartUI();
            quantities[productId] = 1;
            document.getElementById('qty-' + productId).innerText = 1;
        }

        function updateCartUI() {
            document.getElementById('cart-badge').innerText = cart.length;
            document.getElementById('cart-badge-2').innerText = cart.length;
            
            const cartList = document.getElementById('cart-list');
            const totalPrice = document.getElementById('cart-total-price');
            
            if (cart.length === 0) {
                cartList.innerHTML = '<p style="color:var(--text-muted); text-align:center; margin-top:20px; font-size:18px;">السلة فاضية حالياً</p>';
            } else {
                cartList.innerHTML = '';
                cart.forEach((item) => {
                    cartList.innerHTML += `
                        <div class="cart-item">
                            <div class="cart-item-info">
                                <span style="font-size:28px;">🛒</span>
                                <div style="display:flex; flex-direction:column;">
                                    <span class="cart-item-name">${item.name}</span>
                                    <span class="cart-item-qty">الكمية: ${item.qty}</span>
                                </div>
                            </div>
                            <span class="cart-item-price">${item.price * item.qty}</span>
                        </div>
                    `;
                });
            }
            totalPrice.innerText = total + ' د.ج';
        }

        function openSheet(title, options, element) {
            activePickerElement = element;
            document.getElementById('sheet-title').innerText = 'اختر ' + title;
            const optionsContainer = document.getElementById('sheet-options');
            optionsContainer.innerHTML = '';
            
            options.forEach(opt => {
                optionsContainer.innerHTML += `
                    <div class="sheet-option" onclick="selectOption('${opt}', this)">${opt}</div>
                `;
            });

            document.getElementById('sheet-overlay').classList.add('active');
            document.getElementById('bottom-sheet').classList.add('active');
        }

        function closeSheet() {
            document.getElementById('sheet-overlay').classList.remove('active');
            document.getElementById('bottom-sheet').classList.remove('active');
        }

        function selectOption(value, optionElement) {
            if (activePickerElement) {
                activePickerElement.querySelector('.picker-value').innerText = value + ' ▼';
            }
            document.querySelectorAll('.sheet-option').forEach(el => el.classList.remove('selected'));
            optionElement.classList.add('selected');
            setTimeout(closeSheet, 200); 
        }
    </script>
</body>
</html>
